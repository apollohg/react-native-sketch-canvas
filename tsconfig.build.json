{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "react"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__",
    "src/type-tests"
  ]
}
