{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": [
            "ES2020"
        ],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "jest",
            "react"
        ],
        "typeRoots": [
            "./node_modules/@types"
        ],
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/__tests__"
    ]
}
